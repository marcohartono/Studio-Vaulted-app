# Required — generate with: openssl rand -hex 32
LICENSE_SERVER_SECRET=change-me-to-a-long-random-secret

# Required — signs license keys (used by the server and scripts/generate-key.ts).
# Generate with: openssl rand -hex 32. Never commit the real value or put it in the app.
APP_SECRET=change-me-to-a-long-random-secret

