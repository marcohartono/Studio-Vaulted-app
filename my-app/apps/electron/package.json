{
  "name": "@my-app/electron",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:electron": "wait-on dist/main/main.js tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electronmon dist/main/main.js",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "start": "electron dist/main/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@my-app/stripe": "1.0.0",
    "@my-app/types": "1.0.0",
    "electron": "^33.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electronmon": "^2.0.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
